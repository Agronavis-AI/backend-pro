# cp .env.example .env, then fill in the blanks.
# EXPO_PUBLIC_* values are compiled into the APK and extractable from it.
# Never put a secret behind that prefix.

# Server
NODE_ENV=development
# development | staging | production — which deployment this is, and so
# whose data it serves. NODE_ENV stays a Node concern.
APP_ENV=development
PORT=3001
API_VERSION=v1
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:19006
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Supabase — Project Settings ▸ API Keys. Both must be from the same project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still issuing legacy HS256 tokens; ES256 uses JWKS.
SUPABASE_JWT_SECRET=

# Third-party APIs — backend only
# openweathermap.org/api ▸ API keys
OPENWEATHER_API_KEY=
# data.gov.in ▸ profile, then subscribe to the Agmarknet mandi resource
# NASA FIRMS. Free and instant from
# firms.modaps.eosdis.nasa.gov/api/map_key — no card, no approval wait.
# Without it the stubble-burning warnings stay off; nothing else changes.
FIRMS_MAP_KEY=
AGMARKNET_API_KEY=
# Generated locally: openssl rand -base64 48
TOTP_ENCRYPTION_KEY=

# Mobile — public, shipped in the app bundle
# On a device use your LAN IP, not localhost.
# Mapbox. The pk.* token is public and ships in the app; the sk.* download
# token only fetches the native SDK at build time and must stay a secret.
# Satellite imagery is on the free tier and needs no billing account, which is
# why this is not Google Maps — that watermarks every tile until one is added.

# ─── The website's forms ──────────────────────────────────────────────────
# Optional. Without these, /api/contact, /demo, /newsletter, /careers and
# /account-deletion answer 503 with an address to write to instead. Nothing
# the app depends on is affected.
RESEND_API_KEY=
CONTACT_TO=contact@agronavis.in
CONTACT_FROM=Agronavis <noreply@agronavis.in>
SITE_URL=https://www.agronavis.in
SEND_AUTOREPLY=false
