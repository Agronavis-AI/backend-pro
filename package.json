{
  "name": "agronavis-api",
  "version": "1.0.0",
  "private": true,
  "description": "Agronavis API \u2014 the app and the website",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "sync:catalogue": "tsx src/jobs/catalogue.cli.ts",
    "sync:soil": "tsx src/jobs/soil.cli.ts",
    "sync:fertiliser": "tsx src/jobs/fertiliser.cli.ts",
    "sync:mandi": "tsx src/jobs/mandi.cli.ts",
    "sync:fires": "tsx src/jobs/fires.cli.ts",
    "sync:ndvi": "tsx src/jobs/ndvi.cli.ts",
    "seed:diseases": "tsx src/jobs/diseases.cli.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "axios": "^1.7.9",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "geotiff": "^3.0.5",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "onnxruntime-node": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^3.4.0",
    "proj4": "^2.22.0",
    "qrcode": "^1.5.4",
    "resend": "^4.0.1",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.12",
    "@types/node-cron": "^3.0.11",
    "@types/pngjs": "^6.0.5",
    "@types/proj4": "^2.5.6",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
